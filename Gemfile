source "https://rubygems.org"

# Pin the GitHub Pages gem so local preview matches the native Pages build.
# Pages does not run Bundler. It builds with its own copy of this gem.
# Current dependency set: https://pages.github.com/versions.json
gem "github-pages", "232", group: :jekyll_plugins

# Ruby 3 does not ship webrick as a default gem. `jekyll serve` needs it locally.
gem "webrick", "~> 1.8"
